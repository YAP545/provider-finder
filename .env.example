# --- Politeness: put a real contact so site owners can reach you ---
BOT_CONTACT=you@example.com

# --- LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to run in rule-based mode. ---
# Option A: Google Gemini free tier (key from https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=

# Option B: Groq free tier
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: Ollama, fully local and free (ollama pull llama3.1)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama
