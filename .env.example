# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# --- LLM (required for AI evaluation mode) ---
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# --- LLM endpoint (leave blank for Google Gemini) ---
# Set to your endpoint for Groq, Ollama, or any OpenAI-compatible API.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Crawler identity (optional) ---
BOT_CONTACT=your-email@example.com
